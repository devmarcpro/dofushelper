{
  "name": "roadbook",
  "version": "0.0.1",
  "private": true,
  "description": "Roadbook — site compagnon Dofus 3 : choisis un objectif, coche ce que tu as fait, obtiens la marche à suivre.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:snapshot": "tsx scripts/snapshot/main.ts",
    "data:build": "tsx scripts/build-data/main.ts",
    "data:report": "tsx scripts/build-data/report.ts",
    "data:fixture": "tsx scripts/build-data/fixture.ts"
  },
  "dependencies": {
    "@preact/signals": "2.11.2",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
